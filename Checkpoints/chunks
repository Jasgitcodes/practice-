package piscine

import "github.com/01-edu/z01"

func PrintNbr(n int) {
	if n >= 10 {
		PrintNbr(n / 10)
	}

	z01.PrintRune(rune(n%10 + '0'))
}


func Chunk(slice []int size int){
	if size <= 0 {
		z01.PrintRune('\n')
		return
	}

	z01.PrintRune('[')
	for i := 0; i < len(slice); i+= size {
		if i > 0 {
			z01.PrintRune(' ')
		}	

		z01.PrintRune('[')
			end := i + size


			for j:= i; j  < end; j++ {
				if j > i {
					z01.PrintRune(' ')
				}

				zo1.PrintRune(slice[j])
			}

		z01.PrintRune(']')
		}

	z01.PrintRune(']')
	z01.PrintRune('\n')
}
